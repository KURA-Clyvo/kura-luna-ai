# Oracle 19c — modo thin (sem Instant Client)
ORACLE_DSN=oracle.host:1521/ORCL
ORACLE_USER=kura_user
ORACLE_PASSWORD=secret

# Twilio WhatsApp Sandbox
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+14155238886

# Pesos dos modelos de IA — extra opcional (LU-06: pip install -r requirements-vision.txt,
# ou build da imagem com --build-arg WITH_VISION=true). Default vazio: `luna detect` falha
# explícito (EXIT=2) em vez de a Settings() do processo inteiro recusar iniciar sem isto.
YOLO_WEIGHTS_PATH=src/ai/models/yolov8n.pt
BREED_CLASSIFIER_WEIGHTS_PATH=src/ai/models/breed_classifier.pth

# Logging
LOG_LEVEL=INFO
# Caminho do arquivo de log (default: logs/luna.log, relativo ao cwd). LOG_TO_FILE=false
# desliga o handler de arquivo (console-only) — ver N8 no relatório de LU-06.
# LOG_FILE_PATH=logs/luna.log
# LOG_TO_FILE=true

# Integração Kura .NET (v2.0)
KURA_API_BASE_URL=http://host.docker.internal:8080
KURA_API_KEY=your-luna-api-key
KURA_API_TIMEOUT=10

# Servidor HTTP (v2.0)
WEBHOOK_PUBLIC_URL=https://xxxx.ngrok.io/webhook/twilio/whatsapp
LUNA_HTTP_PORT=8000

# Auth inbound de POST /whatsapp/enviar (mobile-clinica-rn chama a Luna direto,
# não via .NET). Sem isto, a validação em web/routers/whatsapp.py compara contra
# "" e rejeita 100% das chamadas com 401. Deve bater com o EXPO_PUBLIC_LUNA_API_KEY
# de mobile-clinica-rn/.env.
LUNA_INBOUND_API_KEY=your-luna-inbound-key

# OpenAI Whisper — transcrição de áudio em POST /transcricao (custo ~$0.006/min de áudio).
# Sem isto, o endpoint sempre cai no fallback {transcricao:null, soap:null}.
OPENAI_API_KEY=sk-your-openai-key

# Scheduler do lembrete de vacina (LU-04). Default false — ligar em UMA réplica
# só (mais de uma réplica com a flag true duplica o envio diário). O gatilho
# manual (POST /jobs/lembrete-vacina/executar, com X-API-Key) funciona mesmo
# com a flag desligada.
LUNA_SCHEDULER_ENABLED=false
LUNA_SCHEDULER_HORA=8

# CORS (origens do navegador, separadas por vírgula) — necessário para o
# mobile-clinica-rn na web chamar /whatsapp/enviar e /transcricao. Vazio = sem CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:8082,https://<app-da-clinica-hospedado>
